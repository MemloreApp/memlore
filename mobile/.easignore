# EAS Build upload filter for mobile/. When this file exists EAS reads it
# INSTEAD of .gitignore, so it repeats the build-output and secret patterns.
# No `!` negation. Checked by scripts/easignore-check.sh.

# Dependencies and build output
node_modules/
dist/
web-build/
*.tsbuildinfo
coverage/
test-results/

# Expo: generated native projects (CNG) and caches. Anchored, so the native
# module sources under modules/*/ios stay in the upload.
/ios/
/android/
.expo/
expo-env.d.ts
.kotlin/
.metro-health-check*
*.orig.*
# Generated by pnpm mobile:core:ios; EAS rebuilds them (roadmap M9).
modules/memlore-core/ios/Generated/
*.xcframework

# Not part of the mobile app
docs/

# Secrets and signing material
**/.env*
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.jks
**/*.mobileprovision
**/*.provisionprofile
**/client_secret*.json
**/google_cloud_*.json
**/passphrase.txt
**/release-secrets/

# Logs and local tooling
*.log
npm-debug.*
.DS_Store
.claude/
CLAUDE.md
AGENTS.md
