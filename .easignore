# EAS Build upload filter. When this file exists EAS reads it INSTEAD of
# .gitignore, so it repeats the build-output and secret patterns from
# .gitignore. Written from scratch: no `!` negation (the .gitignore negations
# under docs/ would re-include files). Checked by scripts/easignore-check.sh.

# Dependencies and build output
node_modules/
.pnpm-store/
dist/
dist-ssr/
dist-lib/
ds-bundle/
*.tsbuildinfo
coverage/
test-results/
playwright-report/
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/swift/**/.build/
src-tauri/swift/**/.swiftpm/
src-tauri/swift/**/Package.resolved
src-tauri/vendor/swift-rs/.build/
/target/
.cargo/
web/src/core/pkg/
web/src/core/pkg-test/
*.deb
*.AppImage
*.dmg
*.exe
*.msi
*.rpm

# Expo: generated native projects (CNG) and caches. Anchored, so the native
# module sources under mobile/modules/*/ios stay in the upload.
/mobile/ios/
/mobile/android/
.expo/
web-build/
.metro-health-check*
# Generated by pnpm mobile:core:ios; EAS rebuilds them (roadmap M9).
mobile/modules/memlore-core/ios/Generated/
*.xcframework

# Not part of the mobile app
docs/
website/
mockup/
e2e/

# Secrets and signing material
**/.env*
.dev.vars*
.wrangler/
.ci/
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.jks
**/*.mobileprovision
**/*.provisionprofile
**/client_secret*.json
**/google_cloud_*.json
**/passphrase.txt
**/release-secrets/

# Logs, media and local tooling
logs/
*.log
*.mp3
*.mp4
*.wav
.DS_Store
Thumbs.db
.idea/
*.sw?
.claude/
.agents/
.cursor/
.devin/
.coding-friend/
.design-sync/
.mcp.json
CLAUDE.md
AGENTS.md
WATCHDOG.yml
skills-lock.json
run-ds-build.sh
run-ds-validate.sh
build-err.txt
.ab-trash/
sync_files
.zcode/
.omo
.codegraph/
.hallmark/
.grok/
.ds-sync/
*.local
.pnpm-debug.log*
vite.config.ts.timestamp-*
